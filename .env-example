PORT=4000
DOMAIN=http://localhost
NOVE_ENV=dev

#FRONTEND
FRONTEND_URL=http://localhost:4200

# MONGO DB
MONGO_URL=

# POSTGRESQL
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=template_obiux
DB_USERNAME=admin_template
DB_PASSWORD=12345
DATABASE_URL=postgresql://admin_template:12345@host.docker.internal:5432/template_obiux?schema=public
POSTGRES_URL=postgresql://admin_template:12345@host.docker.internal:5432/template_obiux?schema=public

# CLICKHOUSE
CH_HOST=localhost
CH_PORT=8123
CH_DB_NAME=login_api
CH_DB_USER=admin
CH_DB_PASSWORD=admin123

# REDIS
REDIS_HOST=localhost
REDIS_PASSWORD=StrongPassword123
REDIS_PORT=6379

# JWT
SECRET_JWT=LOGINAPI1234

# EMAIL / SMTP
APP_NAME=Login API
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAUTH EXTERNAL PROVIDERS
# Google, Microsoft and Facebook include default authorization/token/userinfo URLs.
# Configure client credentials and register these callback URLs in each provider:
# http://localhost:4000/api/v1/auth/google/callback
# http://localhost:4000/api/v1/auth/microsoft/callback
# http://localhost:4000/api/v1/auth/facebook/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=

# Any other provider can be enabled with this pattern:
# OAUTH_CUSTOM_CLIENT_ID=
# OAUTH_CUSTOM_CLIENT_SECRET=
# OAUTH_CUSTOM_AUTHORIZATION_URL=
# OAUTH_CUSTOM_TOKEN_URL=
# OAUTH_CUSTOM_USERINFO_URL=
# OAUTH_CUSTOM_SCOPES=openid email profile
# OAUTH_CUSTOM_USER_ID_FIELD=sub
# OAUTH_CUSTOM_EMAIL_FIELD=email
# OAUTH_CUSTOM_EMAIL_VERIFIED_FIELD=email_verified
# OAUTH_CUSTOM_NAME_FIELD=given_name
# OAUTH_CUSTOM_LAST_NAME_FIELD=family_name
# OAUTH_CUSTOM_PICTURE_FIELD=picture

# OIDC RS256
OIDC_KEY_ID=login-api-rs256
OIDC_PRIVATE_KEY=
OIDC_PUBLIC_KEY=
