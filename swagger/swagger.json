{
  "openapi": {
    "openapi": "3.0.0",
    "info": {
      "title": "Template Fastify API",
      "description": "Mini-framework Fastify con autenticación y arquitectura hexagonal",
      "version": "3.0.0"
    },
    "servers": [{ "url": "http://localhost:4000/api/v1" }],
    "components": {
      "securitySchemes": {
        "apiKey": {
          "type": "apiKey",
          "name": "apiKey",
          "in": "header"
        },
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
      }
    }
  }
}
